# Database connection string (PostgreSQL hosted on Supabase)
DATABASE_URL=
# Direct URL for migrations (if needed on Supabase)
DIRECT_URL=

# JWT Secrets for authentication (generated with openssl rand -base64 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token expiration periods
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Public application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
