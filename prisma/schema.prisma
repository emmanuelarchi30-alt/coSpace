// Esquema de Base de Datos CoSpace
// PostgreSQL en Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum SpaceType {
  DESK
  MEETING_ROOM
  CABIN
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PAID
  REFUNDED
  PENDING
}

// Modelo de Usuarios del sistema
model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  password     String
  role         Role           @default(USER)
  refreshToken String?        // Hash del refresh token para validación rápida
  reservations Reservation[]
  tokens       RefreshToken[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("users")
}

// Modelo de Tokens de Renovación para rotación segura
model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Modelo de Espacios de Coworking
model Space {
  id             String         @id @default(cuid())
  name           String
  description    String
  type           SpaceType
  capacity       Int
  pricePerHour   Decimal        @db.Decimal(10, 2)
  imageUrl       String
  location       String?
  amenities      String[]       // Lista de comodidades en texto para compatibilidad directa
  isActive       Boolean        @default(true) // Regla de negocio: no se elimina, se desactiva
  reservations   Reservation[]
  spaceAmenities SpaceAmenity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("spaces")
}

// Catálogo maestro de comodidades y servicios
model Amenity {
  id             String         @id @default(cuid())
  name           String         @unique
  icon           String?
  description    String?
  spaceAmenities SpaceAmenity[]
  createdAt      DateTime       @default(now())

  @@map("amenities")
}

// Tabla pivote relacional entre espacios y comodidades
model SpaceAmenity {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([spaceId, amenityId])
  @@map("space_amenities")
}

// Modelo de Reservas por horas
model Reservation {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId        String
  space          Space             @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  startTime      DateTime
  endTime        DateTime
  hours          Int
  totalPrice     Decimal           @db.Decimal(10, 2) // Calculado en el servidor (horas * pricePerHour)
  status         ReservationStatus @default(CONFIRMED)
  idempotencyKey String?           @unique // Prevención de doble reserva por reintento
  payment        Payment?
  auditLogs      AuditLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@index([spaceId])
  @@index([startTime, endTime])
  @@map("reservations")
}

// Registro financiero de la transacción de reserva
model Payment {
  id            String        @id @default(cuid())
  reservationId String        @unique
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  status        PaymentStatus @default(PAID)
  paymentMethod String        @default("CREDIT_CARD")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("payments")
}

// Registro de auditoría para trazabilidad de seguridad y reglas de negocio
model AuditLog {
  id            String       @id @default(cuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  action        String       // LOGIN, RESERVATION_CREATED, RESERVATION_CANCELLED, SPACE_DEACTIVATED
  entity        String       // User, Reservation, Space
  entityId      String
  details       String?
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}
