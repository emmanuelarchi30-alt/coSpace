// CoSpace Database Schema
// PostgreSQL on Supabase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum SpaceType {
  DESK
  MEETING_ROOM
  CABIN
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String
  role         Role          @default(USER)
  refreshToken String?       // Hashed refresh token stored securely
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Space {
  id           String        @id @default(cuid())
  name         String
  description  String
  type         SpaceType
  capacity     Int
  pricePerHour Decimal       @db.Decimal(10, 2)
  imageUrl     String
  location     String?
  amenities    String[]      // List of amenities (e.g. WiFi, Pantalla, Café)
  isActive     Boolean       @default(true) // Regla de negocio: no se elimina, se desactiva
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("spaces")
}

model Reservation {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId        String
  space          Space             @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  startTime      DateTime
  endTime        DateTime
  hours          Int
  totalPrice     Decimal           @db.Decimal(10, 2) // Calculado en el servidor (horas * pricePerHour)
  status         ReservationStatus @default(CONFIRMED)
  idempotencyKey String?           @unique // Prevención de doble reserva por retry
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@index([spaceId])
  @@index([startTime, endTime])
  @@map("reservations")
}
